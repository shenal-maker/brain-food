{
  "manifest_version": 3,
  "name": "Brain Food",
  "version": "1.0",
  "description": "Block distracting sites until you complete your daily exercise",

  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "webNavigation"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "settings.html"
  },

  "web_accessible_resources": [
    {
      "resources": ["blocker.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
