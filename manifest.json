{
  "manifest_version": 3,
  "name": "Brain Food",
  "version": "2.0",
  "description": "Block distracting sites until you complete your daily exercise",

  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "webNavigation",
    "idle"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "settings.html"
  },

  "web_accessible_resources": [
    {
      "resources": ["blocker.html", "curriculum.html", "dashboard.html"],
      "matches": ["<all_urls>"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src 'self' https://www.youtube.com https://youtube.com"
  }
}
